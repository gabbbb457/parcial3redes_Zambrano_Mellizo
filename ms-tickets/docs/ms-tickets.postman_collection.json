    "_exporter_id": "48922100"
  },
  "item": [
    {
      "name": "0. Autenticación",
      "item": [
        {
          "name": "Login administrador (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login responde 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve token\", function () { pm.expect(j.token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"token\", j.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUsuarios}}/usuarios/login",
              "host": [
                "{{baseUsuarios}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "description": "Login contra ms-usuarios (puerto 3001). Guarda el token en la variable token."
          },
          "response": []
        },
        {
          "name": "Crear usuario no administrador (201 o 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"201 si se crea, 409 si ya existía\", function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Despacho\",\n  \"email\": \"{{noAdminEmail}}\",\n  \"rol\": \"despacho\",\n  \"password\": \"{{noAdminPassword}}\"\n}",
              "options": {
