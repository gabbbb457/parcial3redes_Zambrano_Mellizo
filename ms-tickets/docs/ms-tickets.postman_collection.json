            "url": {
              "raw": "{{baseUsuarios}}/usuarios",
              "host": [
                "{{baseUsuarios}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Prepara el usuario con rol despacho (debe estar en ROLES del .env de ms-usuarios)."
          },
          "response": []
        },
